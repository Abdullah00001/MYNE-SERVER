# Copy this file to .env and fill in the values for your MongoDB credentials, Redis configuration, JWT secret keys, SMTP email settings, AWS S3 credentials, and currency exchange API key.

# ===============================
#  General Configuration
# ===============================
# Set to 'production' for a production environment
NODE_ENV=development
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=
MONGO_APP_PASSWORD=
MONGO_DB_NAME=
BACKUP_RETAIN_DAYS=
DATABASE_URL=

# ========================================
#  Redis Configuration
# ========================================
REDIS_HOST=redis
REDIS_PASSWORD=myStrongRedisPassword
REDIS_PORT=6379

# ========================================
#  JSON Web Token (JWT) Secret Keys
# ========================================
JWT_ACCESS_TOKEN_SECRET_KEY=
JWT_REFRESH_TOKEN_SECRET_KEY=
JWT_VERIFY_OTP_PAGE_SECRET_KEY=

# ===============================
#  Authentication & Security
# ===============================
OTP_HASH_SECRET=abaccf1d9ffbf3fbcb16ef08110f3c958e7f3602526502ac29a934780db82dd6


# ===============================
#  Email Configuration (SMTP)
# ===============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=abdullahchowdhury00001@gmail.com
SMTP_PASS=

# ===============================
#  AWS S3 Credential
# ===============================

